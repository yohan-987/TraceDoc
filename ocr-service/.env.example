# Copy to .env (optional). Real environment variables take precedence.
# Relative paths are resolved against ocr-service/.
DATA_DIR=../data
RENDER_DPI=150
ANALYZER_TIMEOUT_S=30
MAX_PAGES=100
MAX_IMAGE_PIXELS=50000000
MAX_TOTAL_PIXELS=400000000
# CONTRACTS_DIR=../contracts

# OCR (O2)
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=eng
OCR_PAGE_TIMEOUT_S=25

# OCR engines (O2 part 2)
# auto = PaddleOCR first, Tesseract fallback | tesseract | paddleocr (no fallback)
OCR_ENGINE=auto
PADDLE_LANG=en
# OCR_WARMUP=1            # initialise PaddleOCR in the background at startup

# Development only: enables GET /debug/ocr/{docId}/{page}. Never enable in production.
# DEBUG_ENDPOINTS=1

# PaddleOCR oneDNN (MKL-DNN). Keep 0: PaddlePaddle 3.3.x fails with "ConvertPirAttribute2RuntimeAttribute not support"
# when it is on (x86-64 CPU).
PADDLE_ENABLE_MKLDNN=0

# Page classifier (O3): thresholds file (default config/classifier.json) and recorded OCR fixtures folder
# CLASSIFIER_CONFIG=config/classifier.json
# OCR_FIXTURES_DIR=../contracts/fixtures/ocr

# Field extractor (O4): schema folder (default app/schemas) and the expected-values manifest for the accuracy report
# FIELD_SCHEMAS_DIR=app/schemas
# SAMPLES_MANIFEST=../samples/manifest.json

# D1 accuracy evaluation (tools/d1_accuracy_report.py)
# D1_MANIFEST=../samples/manifest.json

# Image forensics (O8): thresholds file (default config/image_forensics.json)
# IMAGE_FORENSICS_CONFIG=config/image_forensics.json

# Layout/tables (O5): header vocabulary and thresholds file (default config/layout.json)
# LAYOUT_CONFIG=config/layout.json

# Text layer vs render (O6): thresholds file (default config/text_layer_check.json)
# TEXT_LAYER_CHECK_CONFIG=config/text_layer_check.json
