{
  "name": "tracedocs-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TraceDocs backend platform: ingestion, jobs, storage, review, reports",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
